MainTab:CreateButton({
   Name = "Выдать молоток",
   Callback = function()
      pcall(function()
         local backpack = LocalPlayer:FindFirstChild("Backpack")
         if not backpack then return end
         
         local hammerFound = nil
         
         for _, item in pairs(game:GetDescendants()) do
            if item:IsA("Tool") and (item.Name:lower():find("hammer") or item.Name:lower():find("молоток")) then
               hammerFound = item
               break
            end
         end
         
         if not hammerFound then
            for _, item in pairs(game:GetDescendants()) do
               if (item:IsA("Model") or item:IsA("BasePart")) and (item.Name:lower():find("hammer") or item.Name:lower():find("молоток")) then
                  local toolAncestor = item:FindFirstAncestorOfClass("Tool")
                  if toolAncestor then
                     hammerFound = toolAncestor
                     break
                  end
               end
            end
         end
         
         if hammerFound then
            local clonedHammer = hammerFound:Clone()
            clonedHammer.Parent = backpack
            Rayfield:Notify({Title = "Успех", Content = "Молоток выдан в инвентарь!", Duration = 3})
         else
            local promptTriggered = false
            for _, prompt in pairs(workspace:GetDescendants()) do
               if prompt:IsA("ProximityPrompt") then
                  local parentName = prompt.Parent and prompt.Parent.Name:lower() or ""
                  if parentName:find("hammer") or parentName:find("молоток") then
                     fireproximityprompt(prompt)
                     promptTriggered = true
                     break
                  end
               end
            end
            
            if promptTriggered then
               Rayfield:Notify({Title = "Инфо", Content = "Молоток поднят с карты!", Duration = 3})
            else
               Rayfield:Notify({Title = "Ошибка", Content = "Молоток не найден на карте или в памяти!", Duration = 3})
            end
         end
      end)
   end,
})

MainTab:CreateToggle({
   Name = "Сломать доски (BETA)",
   CurrentValue = false,
   Callback = function(Value) _G.AutoBreakPlanks = Value end,
})

task.spawn(function()
   while task.wait(0.3) do
      if _G.AutoBreakPlanks then
         pcall(function()
            local char = LocalPlayer.Character
            local bp = LocalPlayer:FindFirstChild("Backpack")
            local hasHammer = false
            
            if bp then
               for _, item in pairs(bp:GetChildren()) do
                  if item.Name:lower():find("hammer") or item.Name:lower():find("молоток") then
                     hasHammer = true
                     break
                  end
               end
            end
            if not hasHammer and char then
               for _, item in pairs(char:GetChildren()) do
                  if item:IsA("Tool") and (item.Name:lower():find("hammer") or item.Name:lower():find("молоток")) then
                     hasHammer = true
                     break
                  end
               end
            end

            if hasHammer then
               for _, v in pairs(workspace:GetDescendants()) do
                  if v.Name:lower():find("plank") or v.Name:lower():find("доск") then
                     local prompt = v:FindFirstChildOfClass("ProximityPrompt") or (v.Parent and v.Parent:FindFirstChildOfClass("ProximityPrompt"))
                     if prompt and prompt.Enabled then fireproximityprompt(prompt) end
                  end
               end
            end
         end)
      end
   end
end)

MainTab:CreateToggle({
   Name = "Найти молоток (BETA)",
   CurrentValue = false,
   Callback = function(Value) _G.AutoHammer = Value end,
})

task.spawn(function()
   while task.wait(0.2) do
      if _G.AutoHammer then
         pcall(function()
            local char = LocalPlayer.Character
            local bp = LocalPlayer:FindFirstChild("Backpack")
            local hasHammer = false
            
            if bp then
               for _, item in pairs(bp:GetChildren()) do
                  if item.Name:lower():find("hammer") or item.Name:lower():find("молоток") then
                     hasHammer = true
                     break
                  end
               end
            end
            if not hasHammer and char then
               for _, item in pairs(char:GetChildren()) do
                  if item:IsA("Tool") and (item.Name:lower():find("hammer") or item.Name:lower():find("молоток")) then
                     hasHammer = true
                     break
                  end
               end
            end

            if hasHammer then
               _G.AutoHammer = false
            else
               for _, prompt in pairs(workspace:GetDescendants()) do
                  if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                     local parentName = prompt.Parent and prompt.Parent.Name:lower() or ""
                     if parentName:find("hammer") or parentName:find("молоток") or prompt.ObjectText:lower():find("hammer") or prompt.ObjectText:lower():find("молоток") then
                        fireproximityprompt(prompt)
                     end
                  end
               end
            end
         end)
      end
   end
end)

