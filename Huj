PlayerTab:CreateToggle({
   Name = "Платформа под ногами",
   CurrentValue = false,
   Callback = function(Value)
      _G.BigPlatform = Value
      if Value then
         pcall(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
               fixedPlatformY = LocalPlayer.Character.HumanoidRootPart.Position.Y - 3.5
               if not bigPlatformPart or not bigPlatformPart.Parent then
                  bigPlatformPart = Instance.new("Part")
                  bigPlatformPart.Name = "BigPlatform"
                  bigPlatformPart.Size = Vector3.new(500, 2, 500)
                  bigPlatformPart.Anchored = true
                  bigPlatformPart.CanCollide = true
                  bigPlatformPart.Material = Enum.Material.SmoothPlastic
                  bigPlatformPart.Color = Color3.fromRGB(0, 170, 255)
                  bigPlatformPart.Transparency = 0.4
                  bigPlatformPart.Parent = workspace
               end
               Rayfield:Notify({Title = "Платформа", Content = "Платформа создана!", Duration = 3})
            end
         end)
      else
         if bigPlatformPart then
            bigPlatformPart:Destroy()
            bigPlatformPart = nil
         end
      end
   end,
})

RunService.RenderStepped:Connect(function()
   if _G.BigPlatform and bigPlatformPart and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
      bigPlatformPart.CFrame = CFrame.new(LocalPlayer.Character.HumanoidRootPart.Position.X, fixedPlatformY, LocalPlayer.Character.HumanoidRootPart.Position.Z)
   end
end)

