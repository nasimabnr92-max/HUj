---------------------------------------------------------
local function spinWheelAction()
   pcall(function()
      local wheelEvent = ReplicatedStorage:FindFirstChild("WheelCooldownEvent")
      if wheelEvent then
         wheelEvent:FireServer("Sync")
         wheelEvent:FireServer("BuySpin")
      end
      
      local spinModel = workspace:FindFirstChild("Spin", true) or workspace:FindFirstChild("SpinWheel", true) or workspace:FindFirstChild("Wheel", true)
      if spinModel then
         for _, prompt in pairs(spinModel:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") then
               fireproximityprompt(prompt)
            end
         end
      end
   end)
end

SpinTab:CreateButton({
   Name = "Крутануть колесо прямо сейчас",
   Callback = function()
      spinWheelAction()
      Rayfield:Notify({Title = "Spin", Content = "Запрос отправлен и ProximityPrompt активирован!", Duration = 3})
   end,
})

